 "eras": {
  "china": [
   {
    "id": "c_pre_qin",
    "name": "先秦",
    "span": "前1600–前221",
    "desc": "青铜礼器、玉器、战国帛画，美术服务于礼制与巫祭。"
   },
   {
    "id": "c_qin_han",
    "name": "秦汉",
    "span": "前221–220",
    "desc": "墓室壁画、画像石、兵马俑，重叙事与纪实。"
   },
   {
    "id": "c_weijin",
    "name": "魏晋南北朝",
    "span": "220–589",
    "desc": "佛教美术兴起，敦煌、云冈、龙门开窟；绘画从记事转向传神。"
   },
   {
    "id": "c_tang",
    "name": "隋唐",
    "span": "581–907",
    "desc": "人物画鼎盛，青绿与水墨分流，壁画与卷轴并盛。"
   },
   {
    "id": "c_five",
    "name": "五代",
    "span": "907–960",
    "desc": "荆关董巨确立南北山水两大体系。"
   },
   {
    "id": "c_song",
    "name": "宋",
    "span": "960–1279",
    "desc": "院体写实高峰，文人画理论成型，山水、花鸟、风俗画全面成熟。"
   },
   {
    "id": "c_yuan",
    "name": "元",
    "span": "1271–1368",
    "desc": "书画同源，元四家把山水推向写意与笔墨自律。"
   },
   {
    "id": "c_ming",
    "name": "明",
    "span": "1368–1644",
    "desc": "吴门、松江、青藤白阳；南北宗论重构画史谱系。"
   },
   {
    "id": "c_qing",
    "name": "清",
    "span": "1644–1911",
    "desc": "四僧、扬州八怪、海上画派；个性与金石入画。"
   },
   {
    "id": "c_modern",
    "name": "近现代",
    "span": "1840–1990",
    "desc": "中西碰撞，写实改造、笔墨自新与中西调和三条路。"
   }
  ],
  "west": [
   {
    "id": "w_antiquity",
    "name": "古代",
    "span": "前800–400",
    "desc": "希腊罗马的写实理想、人体比例与建筑秩序。"
   },
   {
    "id": "w_medieval",
    "name": "中世纪",
    "span": "400–1400",
    "desc": "拜占庭镶嵌、罗马式与哥特式，图像服务于信仰。"
   },
   {
    "id": "w_renaissance",
    "name": "文艺复兴",
    "span": "1400–1600",
    "desc": "透视法、解剖与人文主义；意大利与北方两条路。"
   },
   {
    "id": "w_baroque",
    "name": "巴洛克",
    "span": "1600–1750",
    "desc": "戏剧性明暗、动势与感官真实；荷兰市民绘画兴起。"
   },
   {
    "id": "w_rococo_classicism",
    "name": "洛可可—新古典",
    "span": "1700–1830",
    "desc": "从宫廷纤巧到理性庄重，大卫、安格尔重建古典秩序。"
   },
   {
    "id": "w_romanticism",
    "name": "浪漫主义",
    "span": "1780–1850",
    "desc": "情感、自然崇高与异国情调，对抗理性规范。"
   },
   {
    "id": "w_realism",
    "name": "现实主义",
    "span": "1840–1880",
    "desc": "把普通劳动者与日常场景搬进大画幅。"
   },
   {
    "id": "w_impressionism",
    "name": "印象派",
    "span": "1860–1890",
    "desc": "外光、瞬间与色彩分解，绘画从'画什么'转向'怎么看'。"
   },
   {
    "id": "w_post_impressionism",
    "name": "后印象派",
    "span": "1880–1905",
    "desc": "塞尚的结构、梵高的笔触、高更的象征，各自通向现代。"
   },
   {
    "id": "w_modernism",
    "name": "现代主义",
    "span": "1905–1960",
    "desc": "立体主义、抽象、超现实与抽象表现主义，形式自我革命。"
   },
   {
    "id": "w_contemporary",
    "name": "战后与当代",
    "span": "1950–1990",
    "desc": "波普、极少、观念，艺术边界从画面转向问题。"
   }
  ]
 },
